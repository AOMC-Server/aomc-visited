{
	"schemaVersion": 1,
	"id": "aomc_visited",
	"version": "${version}",
	"name": "AOMC Webmapper",
	"description": "Remembers where you have been, then exports those areas from Xaero's World Map and uploads them to the community webmap.",
	"authors": [
		"sunngoose"
	],
	"icon": "assets/aomc_visited/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.sh4sh.aomcvisited.Platform"
		]
	},
	"mixins": [
		"aomc_visited.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"xaeroworldmap": ">=${xaero_worldmap_version}"
	}
}
